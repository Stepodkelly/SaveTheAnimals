GEMINI_API_KEY=
EXA_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional deployed API base for the static GitHub Pages frontend.
# Example: VITE_API_BASE_URL=https://save-the-animals-api.onrender.com
VITE_API_BASE_URL=

# Server deployment controls.
HOST=127.0.0.1
PORT=4173
ALLOWED_ORIGINS=https://stepodkelly.github.io,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173

# Optional Copernicus Data Space credentials for full Sentinel-1 VV/VH raster downloads.
# Metadata and quicklook pulls do not require these, but COG/GRD band downloads do.
CDSE_USERNAME=
CDSE_PASSWORD=
CDSE_ACCESS_TOKEN=
CDSE_REFRESH_TOKEN=
