{
  "name": "ranger-route",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.js",
    "dev:api": "node server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "v2:validate-replay": "node versions/v2-forecast-mvp/tools/validate-replay-manifest.mjs",
    "v2:pull-sentinel1": "node versions/v2-forecast-mvp/tools/pull-sentinel1-stac.mjs",
    "v2:download-sentinel1-quicklooks": "node versions/v2-forecast-mvp/tools/download-sentinel1-quicklooks.mjs",
    "build": "tsc && vite build",
    "build:pages": "tsc && GITHUB_PAGES=true vite build --outDir docs && cp docs/index.html docs/404.html",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "express": "^4.19.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
